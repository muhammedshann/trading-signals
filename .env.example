NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Google Cloud OAuth 2.0 credentials with the Gmail API gmail.send scope.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
# Optional; if blank, the server uses SUPABASE_SERVICE_ROLE_KEY to HMAC OTPs.
OTP_HASH_SECRET=
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=
# Optional in local test mode: API signature verification can confirm captured payments.
# Configure this before enabling the Razorpay webhook in production.
RAZORPAY_WEBHOOK_SECRET=
# Optional until Telegram access is configured.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
CRON_SECRET=
